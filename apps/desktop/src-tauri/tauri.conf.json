{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiirmärge",
  "version": "0.1.0",
  "identifier": "eu.leksiko.kiirmarge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiirmärge",
        "width": 560,
        "height": 440,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}